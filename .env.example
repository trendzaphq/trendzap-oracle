# =============================================================
# TrendZap Oracle — Environment Configuration
# =============================================================

# ─── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ─── Redis (BullMQ job queue + Pub/Sub) ───────────────────────
REDIS_URL=redis://localhost:6379

# ─── Twitter/X API v2 ────────────────────────────────────────
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# ─── TikTok Research API ─────────────────────────────────────
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret

# ─── Instagram Graph API ─────────────────────────────────────
INSTAGRAM_APP_ID=your_app_id
INSTAGRAM_APP_SECRET=your_app_secret
INSTAGRAM_ACCESS_TOKEN=your_access_token

# ─── YouTube Data API v3 ─────────────────────────────────────
YOUTUBE_API_KEY=your_api_key

# ─── Blockchain / On-chain Resolution (REQUIRED) ─────────────
# Private key of the oracle signer wallet (ORACLE_ROLE in ViralityMarketV2)
ORACLE_PRIVATE_KEY=0x...your_oracle_wallet_private_key

# Deployed ViralityMarketV2 contract address
MARKET_CONTRACT_ADDRESS=0x...

# Avalanche network config
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Validation ───────────────────────────────────────────────
MIN_CONFIDENCE_SCORE=0.8
MAX_METRIC_AGE_SECONDS=300

# ─── Optional: Alerting ──────────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_KEY=
